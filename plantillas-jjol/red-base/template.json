                  "min": 443,
                  "max": 443
                }
              ]
            }
          ],
          "egress_security_rules": [
            {
              "protocol": "all",
              "destination": "{{cidr}}"
            }
          ],
          "freeform_tags": "{{tags}}"
        },
        "unknown": [
          "id",
          "vcn_id"
        ],
        "refs": [
          "oci_core_vcn.this"
        ]
      },
      {
        "type": "oci_core_subnet",
        "name": "private",
        "values": {
          "display_name": "snet-privada-{{name}}-{{environment}}",
          "prohibit_public_ip_on_vnic": true,
          "freeform_tags": "{{tags}}"
        },
        "unknown": [
          "id",
          "vcn_id",
          "cidr_block",
          "security_list_ids"
        ],
        "refs": [
          "oci_core_vcn.this",
          "oci_core_security_list.private"
        ]
      },
      {
        "type": "oci_core_subnet",
        "name": "public",
        "values": {
          "display_name": "snet-publica-{{name}}-{{environment}}",
          "prohibit_public_ip_on_vnic": false,
          "freeform_tags": "{{tags}}"
        },
        "unknown": [
          "id",
          "vcn_id",
          "cidr_block",
          "security_list_ids"
        ],
        "refs": [
          "oci_core_vcn.this",
          "oci_core_security_list.public"
        ]
      },
      {
        "type": "oci_logging_log",
        "name": "flow_privada",
        "values": {
          "display_name": "flow-privada-{{name}}-{{environment}}",
          "log_type": "SERVICE",
          "is_enabled": true,
          "configuration": [
            {
              "source": {
                "category": "all",
                "service": "flowlogs",
                "source_type": "OCISERVICE"
              }
            }
          ],
          "freeform_tags": "{{tags}}"
        },
        "unknown": [
          "id",
          "log_group_id"
        ],
        "refs": [
          "oci_core_subnet.private"
        ]
      },
      {
        "type": "oci_logging_log",
        "name": "flow_publica",
        "values": {
          "display_name": "flow-publica-{{name}}-{{environment}}",
          "log_type": "SERVICE",
          "is_enabled": true,
          "configuration": [
            {
              "source": {
                "category": "all",
                "service": "flowlogs",
                "source_type": "OCISERVICE"
              }
            }
          ],
          "freeform_tags": "{{tags}}"
        },
        "unknown": [
          "id",
          "log_group_id"
        ],
        "refs": [
          "oci_core_subnet.public"
        ]
      },
      {
        "type": "oci_core_nat_gateway",
        "name": "this",
        "values": {
          "display_name": "nat-{{name}}-{{environment}}",
          "freeform_tags": "{{tags}}"
