{
  "id": "red-base",
  "name": "Red base",
  "description": "Red privada lista para cargas: subredes privadas y públicas, reglas de entrada cerradas desde Internet, salida por NAT y registros de flujo.",
  "icon": "network",
  "providers": [
    "azure",
    "aws",
    "gcp",
    "oci"
  ],
  "inputs": [
    {
      "name": "name",
      "label": "Nombre",
      "type": "string",
      "default": "",
      "required": true,
      "pattern": "^[a-z][a-z0-9-]{1,22}[a-z0-9]$",
      "help": "De 3 a 24 caracteres: minúsculas, números y guiones; empieza con letra."
    },
    {
      "name": "environment",
      "label": "Ambiente",
      "type": "select",
      "default": "dev",
      "required": true,
      "options": [
        "dev",
        "test",
        "prod"
      ],
      "help": "En prod se activan la protección contra borrado y las copias geo-redundantes."
    },
    {
      "name": "cidr",
      "label": "Rango de direcciones",
      "type": "string",
      "default": "10.10.0.0/16",
      "required": true,
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-4])$",
      "help": "Bloque CIDR privado de la red; se divide en subredes /20."
    },
    {
      "name": "nat",
      "label": "Salida a Internet por NAT",
      "type": "bool",
      "default": true,
      "required": false,
      "help": "Las subredes privadas salen a Internet por un NAT administrado, sin IP pública en las cargas."
    }
  ],
  "sizes": {
    "pequeno": {
      "label": "Pequeño: 1 zona, 30 días de registros",
      "vars": {
        "zones": 1,
        "flow_logs_retention_days": 30
      },
      "monthly": {
        "azure": 37,
        "aws": 40,
        "gcp": 5,
        "oci": 1
      }
    },
    "mediano": {
      "label": "Mediano: 2 zonas, 90 días de registros",
      "vars": {
        "zones": 2,
        "flow_logs_retention_days": 90
      },
      "monthly": {
        "azure": 37,
        "aws": 75,
        "gcp": 10,
        "oci": 2
      }
    },
    "grande": {
      "label": "Grande: 3 zonas, 180 días de registros",
      "vars": {
        "zones": 3,
        "flow_logs_retention_days": 180
      },
      "monthly": {
        "azure": 40,
        "aws": 110,
        "gcp": 20,
        "oci": 5
      }
    }
  },
  "outputs": [
    {
      "name": "network_id",
      "label": "Id de la red",
      "kind": "text"
    },
    {
      "name": "subnets",
      "label": "Subredes",
      "kind": "text"
    }
  ],
  "demo": {
    "azure": [
      {
        "type": "azurerm_virtual_network",
        "name": "this",
        "values": {
          "name": "vnet-{{name}}-{{environment}}",
          "location": "{{location}}",
          "address_space": [
            "{{cidr}}"
          ],
          "tags": "{{tags}}",
          "subnet": []
        },
        "unknown": [
          "id"
        ]
      },
      {
        "type": "azurerm_subnet",
        "name": "app",
        "values": {
          "name": "snet-app",
          "default_outbound_access_enabled": false
        },
        "unknown": [
          "id"
        ],
        "refs": [
          "azurerm_virtual_network.this"
        ]
      },
      {
        "type": "azurerm_subnet",
        "name": "integracion",
        "values": {
          "name": "snet-integracion",
          "default_outbound_access_enabled": false
        },
        "unknown": [
          "id"
        ],
        "refs": [
          "azurerm_virtual_network.this"
        ]
      },
      {
        "type": "azurerm_subnet",
        "name": "datos",
        "values": {
          "name": "snet-datos",
          "default_outbound_access_enabled": false
        },
        "unknown": [
          "id"
        ],
        "refs": [
          "azurerm_virtual_network.this"
        ]
      },
      {
        "type": "azurerm_subnet",
        "name": "endpoints",
        "values": {
          "name": "snet-endpoints",
          "default_outbound_access_enabled": false
        },
        "unknown": [
          "id"
        ],
        "refs": [
          "azurerm_virtual_network.this"
        ]
      },
      {
        "type": "azurerm_network_security_group",
        "name": "this",
        "values": {
          "name": "nsg-{{name}}-{{environment}}",
          "location": "{{location}}",
          "security_rule": [],
          "tags": "{{tags}}"
        },
        "unknown": [
          "id"
        ]
      },
      {
        "type": "azurerm_network_security_rule",
        "name": "deny_internet",
        "values": {
          "name": "deny-internet-inbound",
          "priority": 4000,
          "direction": "Inbound",
          "access": "Deny",
          "protocol": "*",
          "source_port_range": "*",
          "destination_port_range": "*",
          "source_address_prefix": "Internet",
          "destination_address_prefix": "*"
        },
        "unknown": [
          "id"
        ],
        "refs": [
          "azurerm_network_security_group.this"
        ]
      },
      {
        "type": "azurerm_subnet_network_security_group_association",
        "name": "app",
        "values": {},
        "unknown": [
          "id"
        ],
        "refs": [
          "azurerm_subnet.app",
          "azurerm_network_security_group.this"
        ]
      },
      {
        "type": "azurerm_subnet_network_security_group_association",
        "name": "integracion",
        "values": {},
        "unknown": [
          "id"
        ],
        "refs": [
          "azurerm_subnet.integracion",
          "azurerm_network_security_group.this"
        ]
      },
      {
        "type": "azurerm_subnet_network_security_group_association",
        "name": "datos",
        "values": {},
        "unknown": [
          "id"
        ],
        "refs": [
          "azurerm_subnet.datos",
          "azurerm_network_security_group.this"
        ]
      },
      {
        "type": "azurerm_subnet_network_security_group_association",
        "name": "endpoints",
        "values": {},
        "unknown": [
          "id"
        ],
        "refs": [
          "azurerm_subnet.endpoints",
          "azurerm_network_security_group.this"
        ]
      },
      {
        "type": "azurerm_public_ip",
        "name": "nat",
        "values": {
          "name": "pip-nat-{{name}}-{{environment}}",
          "location": "{{location}}",
          "allocation_method": "Static",
          "sku": "Standard",
          "zones": [
            "1"
          ],
          "tags": "{{tags}}"
        },
        "unknown": [
          "id",
          "ip_address"
        ]
      },
      {
        "type": "azurerm_nat_gateway",
        "name": "this",
        "values": {
          "name": "ng-{{name}}-{{environment}}",
          "location": "{{location}}",
          "sku_name": "Standard",
          "tags": "{{tags}}"
        },
        "unknown": [
          "id"
        ]
      }
    ],
    "aws": [
      {
        "type": "aws_vpc",
        "name": "this",
        "values": {
          "cidr_block": "{{cidr}}",
          "enable_dns_support": true,
          "enable_dns_hostnames": true,
          "tags_all": "{{tags}}"
        },
        "unknown": [
          "id",
          "arn"
        ]
      },
      {
        "type": "aws_flow_log",
        "name": "this",
        "values": {
          "traffic_type": "ALL",
          "tags_all": "{{tags}}"
        },
        "unknown": [
          "id",
          "vpc_id",
          "log_destination"
        ],
        "refs": [
          "aws_vpc.this"
        ]
      },
      {
        "type": "aws_default_security_group",
        "name": "this",
        "values": {
          "ingress": [],
          "egress": [],
          "tags_all": "{{tags}}"
        },
        "unknown": [
          "id"
        ],
        "refs": [
          "aws_vpc.this"
        ]
      },
      {
        "type": "aws_subnet",
        "name": "private",
        "values": {
          "map_public_ip_on_launch": false,
          "tags_all": "{{tags}}"
        },
        "unknown": [
          "id",
          "vpc_id",
          "cidr_block"
        ],
        "refs": [
          "aws_vpc.this"
        ]
      },
      {
        "type": "aws_subnet",
        "name": "public",
        "values": {
          "map_public_ip_on_launch": false,
          "tags_all": "{{tags}}"
        },
        "unknown": [
          "id",
          "vpc_id",
          "cidr_block"
        ],
        "refs": [
          "aws_vpc.this"
        ]
      },
      {
        "type": "aws_security_group",
        "name": "app",
        "values": {
          "name": "sg-app-{{name}}-{{environment}}",
          "ingress": [
            {
              "protocol": "tcp",
              "from_port": 443,
              "to_port": 443,
              "cidr_blocks": [
                "{{cidr}}"
              ],
              "ipv6_cidr_blocks": []
            }
          ],
          "egress": [
            {
              "protocol": "-1",
              "from_port": 0,
              "to_port": 0,
              "cidr_blocks": [
                "0.0.0.0/0"
              ],
              "ipv6_cidr_blocks": []
            }
          ],
          "tags_all": "{{tags}}"
        },
        "unknown": [
          "id",
          "vpc_id"
        ],
        "refs": [
          "aws_vpc.this"
        ]
      },
      {
        "type": "aws_eip",
        "name": "nat",
        "values": {
          "domain": "vpc",
          "tags_all": "{{tags}}"
        },
        "unknown": [
          "id",
          "public_ip"
        ]
      },
      {
        "type": "aws_nat_gateway",
        "name": "this",
        "values": {
          "tags_all": "{{tags}}"
        },
        "unknown": [
          "id",
          "allocation_id",
          "subnet_id"
        ],
        "refs": [
          "aws_eip.nat",
          "aws_subnet.public"
        ]
      },
      {
        "type": "aws_cloudwatch_log_group",
        "name": "flow",
        "values": {
          "name": "/plantillas-jjol/vpc/{{name}}-{{environment}}",
          "retention_in_days": "{{flow_logs_retention_days}}",
          "tags_all": "{{tags}}"
        },
        "unknown": [
          "arn"
        ]
      }
    ],
    "gcp": [
      {
        "type": "google_compute_network",
        "name": "this",
        "values": {
          "name": "vpc-{{name}}-{{environment}}",
          "auto_create_subnetworks": false,
          "routing_mode": "REGIONAL"
        },
        "unknown": [
          "id",
          "self_link"
        ]
      },
      {
        "type": "google_compute_subnetwork",
        "name": "app",
        "values": {
          "name": "snet-app-{{name}}-{{environment}}",
          "region": "{{region}}",
          "private_ip_google_access": true,
          "log_config": [
            {
              "aggregation_interval": "INTERVAL_5_SEC",
              "flow_sampling": 0.5,
              "metadata": "INCLUDE_ALL_METADATA"
            }
          ]
        },
        "unknown": [
          "id",
          "network",
          "ip_cidr_range"
        ],
        "refs": [
          "google_compute_network.this"
        ]
      },
      {
        "type": "google_compute_subnetwork",
        "name": "datos",
        "values": {
          "name": "snet-datos-{{name}}-{{environment}}",
          "region": "{{region}}",
          "private_ip_google_access": true,
          "log_config": [
            {
              "aggregation_interval": "INTERVAL_5_SEC",
              "flow_sampling": 0.5,
              "metadata": "INCLUDE_ALL_METADATA"
            }
          ]
        },
        "unknown": [
          "id",
          "network",
          "ip_cidr_range"
        ],
        "refs": [
          "google_compute_network.this"
        ]
      },
      {
        "type": "google_compute_firewall",
        "name": "internal",
        "values": {
          "name": "fw-{{name}}-{{environment}}-interno",
          "direction": "INGRESS",
          "source_ranges": [
            "{{cidr}}"
          ],
          "allow": [
            {
              "protocol": "all",
              "ports": []
            }
          ],
          "log_config": [
            {
              "metadata": "INCLUDE_ALL_METADATA"
            }
          ]
        },
        "unknown": [
          "id",
          "network"
        ],
        "refs": [
          "google_compute_network.this"
        ]
      },
      {
        "type": "google_compute_firewall",
        "name": "iap_ssh",
        "values": {
          "name": "fw-{{name}}-{{environment}}-iap-ssh",
          "direction": "INGRESS",
          "source_ranges": [
            "35.235.240.0/20"
          ],
          "allow": [
            {
              "protocol": "tcp",
              "ports": [
                "22"
              ]
            }
          ],
          "log_config": [
            {
              "metadata": "INCLUDE_ALL_METADATA"
            }
          ]
        },
        "unknown": [
          "id",
          "network"
        ],
        "refs": [
          "google_compute_network.this"
        ]
      },
      {
        "type": "google_compute_firewall",
        "name": "deny_all",
        "values": {
          "name": "fw-{{name}}-{{environment}}-denegar",
          "direction": "INGRESS",
          "priority": 65000,
          "source_ranges": [
            "0.0.0.0/0"
          ],
          "allow": [],
          "deny": [
            {
              "protocol": "all",
              "ports": []
            }
          ],
          "log_config": [
            {
              "metadata": "INCLUDE_ALL_METADATA"
            }
          ]
        },
        "unknown": [
          "id",
          "network"
        ],
        "refs": [
          "google_compute_network.this"
        ]
      },
      {
        "type": "google_compute_router",
        "name": "this",
        "values": {
          "name": "rtr-{{name}}-{{environment}}",
          "region": "{{region}}"
        },
        "unknown": [
          "id",
          "network"
        ],
        "refs": [
          "google_compute_network.this"
        ]
      },
      {
        "type": "google_compute_router_nat",
        "name": "this",
        "values": {
          "name": "nat-{{name}}-{{environment}}",
          "nat_ip_allocate_option": "AUTO_ONLY",
          "source_subnetwork_ip_ranges_to_nat": "ALL_SUBNETWORKS_ALL_IP_RANGES",
          "enable_dynamic_port_allocation": true,
          "log_config": [
            {
              "enable": true,
              "filter": "ERRORS_ONLY"
            }
          ]
        },
        "unknown": [
          "id",
          "router"
        ],
        "refs": [
          "google_compute_router.this"
        ]
      },
      {
        "type": "google_compute_global_address",
        "name": "private_services",
        "values": {
          "name": "psa-{{name}}-{{environment}}",
          "purpose": "VPC_PEERING",
          "address_type": "INTERNAL",
          "prefix_length": 20
        },
        "unknown": [
          "id",
          "network"
        ],
        "refs": [
          "google_compute_network.this"
        ]
      }
    ],
